/* Variable Font */
@font-face {
	font-family: 'Space Grotesk';
	font-style: normal;
	font-weight: 100 900;
	src: url('/fonts/Space_Grotesk/SpaceGrotesk-VariableFont_wght.ttf') format('truetype');
	font-display: swap;
}
