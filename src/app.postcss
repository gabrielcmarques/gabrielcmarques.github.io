/* Variable Font */
@font-face {
	font-family: 'Raleway';
	font-style: normal;
	font-weight: 100 900;
	src: url('/fonts/Raleway/Raleway-VariableFont_wght.ttf') format('truetype');
	font-display: swap;
}

body {
	font-family: 'Space Grotesk', sans-serif;
}

h1 {
	font-family: 'Space Grotesk', sans-serif;
	font-weight: 400;
}
h2 {
	font-family: 'Space Grotesk', sans-serif;
	font-weight: 400;
}

p,
span,
a {
	font-family: 'Raleway', sans-serif;
	font-weight: 400; /* Regular */
}

body {
	background: linear-gradient(to bottom, #0b002c 0%, rgb(0, 56, 120) 100%);
	background-size: cover;
	background-position: bottom;
	background-attachment: fixed;

	/* , url('$lib/assets/images/bg_website_magicpattern.svg'); */
	/* url('$lib/assets/images/bg_website.webp'); */
	/* background-attachment: fixed; */
}

html {
	scroll-behavior: smooth;
}

.blurred-glass {
	/* background: rgba(255, 255, 255, 0.5); */
	/* -webkit-backdrop-filter: blur(5px);
	backdrop-filter: blur(25px); */
	border: 1px solid rgb(140, 140, 140);
}

.card4 {
	background: rgba(0, 108, 138);
	/* background-color: rgb(var(--color-surface-800));
	 */
	/* background: rgba(0, 108, 138, 0.5); */
	/* background: -webkit-linear-gradient(0deg, rgba(0, 108, 138, 0.5) 0%, rgba(0, 27, 72, 0.5) 100%);
	background: linear-gradient(0deg, rgba(0, 108, 138, 0.5) 0%, rgba(0, 27, 72, 0.75) 100%); */
}

